# Copy to .env for local use. Never commit real credentials.
PORT=3001
ROAM_DB_PATH=data/travel-planner.sqlite
ROAM_PUBLIC_URL=http://127.0.0.1:5173

# Resend account email delivery (keep this server-side only).
RESEND_API_KEY=
ROAM_EMAIL_FROM=

# Cloudflare Turnstile form protection (the site key is public; keep the secret server-only).
ROAM_TURNSTILE_SITE_KEY=
ROAM_TURNSTILE_SECRET_KEY=

# Optional server-only token for GET /api/admin/analytics.
ROAM_ADMIN_TOKEN=
